# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/*
!**/build/merged-binary.bin
build/*
!build/merged-binary.bin
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
!build/merged-binary.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Secrets / local env (keep *.env.example commit-safe)
*.env
!*.env.example

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers / IDE local state
.clangd/
.ccls-cache/
compile_commands.json
.cursor/

# VS Code / ESP-IDF extension: machine-specific absolute paths
.vscode/settings.json
.vscode/c_cpp_properties.json
# Keep launch.json / tasks.json shareable if present

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# Rust host tools (Cargo.lock is committed)
host/target/

# Audio self-test captures (tools/audio_selftest.py)
audio_capture/

# Sidecars for the app bundle (tools/build_sidecars.sh)
host/dualeye-app/src-tauri/binaries/
